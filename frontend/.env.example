# Backend API base URL, read at build time by Vite (import.meta.env.VITE_API_BASE_URL).
# Local dev: leave unset, src/config.js falls back to http://localhost:8000.
# Netlify: set this in Site settings -> Environment variables to the deployed
# Cloud Run backend URL (no trailing slash), e.g.:
# VITE_API_BASE_URL=https://fifth-postulate-backend-xxxxx.run.app
VITE_API_BASE_URL=
