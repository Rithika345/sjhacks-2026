# Copy this file to .env for local development and fill in real values.
# In production (Cloud Run), set these as environment variables in the
# service config instead of committing a .env file.

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
ANTHROPIC_API_KEY=your-anthropic-api-key

# Session cookie signing key. Generate a real random value for production,
# e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`.
SESSION_SECRET=dev-only-insecure-secret-change-me

# Vault certificate signing key. Same idea as SESSION_SECRET, generate a
# real random value for production.
VAULT_SECRET=sjhacks-demo-key-2026

# Database. Defaults to a local SQLite file if unset. In production, set
# this to your Supabase Postgres connection string, e.g.:
#   DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=sqlite:///./fifth_postulate.db

# Local dev defaults (leave unset locally). In production, set these to your
# real deployed URLs, e.g.:
#   FRONTEND_URL=https://the-fifth-postulate.netlify.app
#   BACKEND_URL=https://the-fifth-postulate-xxxxx.run.app
#   ALLOWED_ORIGINS=https://the-fifth-postulate.netlify.app
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173
