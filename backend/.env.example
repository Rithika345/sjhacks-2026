# Copy this file to .env for local development and fill in real values.
# In production (Render), set these as environment variables in the
# service dashboard instead of committing a .env file.

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
ANTHROPIC_API_KEY=your-anthropic-api-key

# Local dev defaults (leave unset locally). In production, set these to your
# real deployed URLs, e.g.:
#   FRONTEND_URL=https://the-fifth-postulate.netlify.app
#   BACKEND_URL=https://the-fifth-postulate.onrender.com
#   ALLOWED_ORIGINS=https://the-fifth-postulate.netlify.app
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173
